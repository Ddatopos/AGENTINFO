{
  "name": "agentinfo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "fetch": "tsx src/cli.ts fetch",
    "enrich": "tsx src/cli.ts enrich",
    "rank": "tsx src/cli.ts rank",
    "briefing": "tsx src/cli.ts briefing"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cheerio": "1.0.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "node-cron": "3.0.3",
    "openai": "4.104.0",
    "rss-parser": "3.13.0",
    "undici": "6.28.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
