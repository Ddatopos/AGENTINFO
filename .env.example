# LLM（OpenAI 兼容端点即可：DashScope / OpenRouter / 官方 / 自建代理）
# 不填 LLM_API_KEY 时系统自动降级为关键词规则打分，功能仍完整可用
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ID=qwen-plus
LLM_TIMEOUT=60000

# GitHub PAT（可选）：不填 10 req/min，填了 30 req/min。只需 public_repo 读权限
GITHUB_TOKEN=

# 后端端口
PORT=3100
